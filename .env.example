# Bind locally by default. Do not expose the demo API directly to the Internet.
AGENTSHIELD_HOST=127.0.0.1
AGENTSHIELD_PORT=8080
AGENTSHIELD_MAX_REQUEST_BYTES=262144
FLASK_DEBUG=False
# Optional: absolute path to a deployment-specific identity digest file.
# AGENTSHIELD_AUTH_FILE=/run/secrets/identities.json
